# Preserve existing database placeholder
DATABASE_URL=

# --- Application (Anubhav - backend/app/core/config.py) ---
APP_NAME="Universal AI Web Assistant API"
APP_SLUG="universal-ai-web-assistant"
APP_VERSION="3.0.0"
APP_ENV=development
DEBUG=false
LOG_LEVEL=INFO
HOST=127.0.0.1
PORT=8000
API_V1_PREFIX=/api/v1
DOCS_ENABLED=true
INCLUDE_ERROR_DETAILS=false

# Comma-separated list or JSON array of allowed CORS origins
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173
CORS_ALLOW_CREDENTIALS=true

# --- Authentication (Anubhav - backend/app/services/auth_context.py) ---
# Provide a >=32-byte HS256 secret locally in backend/.env; never commit real secrets.
JWT_SECRET_KEY=
# Opt-in X-User-Id header for local development/test only (never honored in production).
ALLOW_DEV_USER_HEADER=false

# --- LLM Integration (Anubhav - Provider-neutral until team selects provider/model) ---
LLM_PROVIDER=
LLM_MODEL=
LLM_API_KEY=
LLM_BASE_URL=
LLM_TIMEOUT_SECONDS=30.0
LLM_MAX_RETRIES=1
LLM_TEMPERATURE=0.1
LLM_MAX_OUTPUT_TOKENS=1024
