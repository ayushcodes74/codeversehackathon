{
  "manifest_version": 3,
  "name": "Universal AI Web Assistant",
  "version": "3.0.0",
  "description": "Zero-Leak Hybrid AI Web Assistant & Browser Automation Layer",
  "permissions": [
    "activeTab",
    "tabs",
    "scripting",
    "storage",
    "sidePanel",
    "identity"
  ],
  "oauth2": {
    "client_id": "YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com",
    "scopes": [
      "openid",
      "email",
      "profile"
    ]
  },
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "frontend/sidepanel.html"
  },
  "action": {
    "default_title": "Open Universal AI Web Assistant"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*",
        "file:///*"
      ],
      "js": [
        "src/content/dom_inspector.js",
        "src/content/action_executor.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
