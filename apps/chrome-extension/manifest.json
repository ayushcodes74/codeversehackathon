{
  "manifest_version": 3,
  "name": "Universal AI Web Assistant",
  "version": "3.0.0",
  "description": "Zero-Leak Hybrid AI Web Assistant & Browser Automation Layer",
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*",
    "file:///*"
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "src/content/dom_inspector.js",
        "src/content/action_executor.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
