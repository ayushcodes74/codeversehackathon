{
  "manifest_version": 3,
  "name": "Universal AI Web Assistant",
  "version": "3.0.0",
  "description": "Zero-Leak Hybrid AI Web Assistant & Browser Automation Layer",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "sidePanel"
  ],
  "host_permissions": [
    "https://scholarships.gov.in/*",
    "https://www.incometax.gov.in/*",
    "https://parivahan.gov.in/*",
    "https://uidai.gov.in/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "Open Universal AI Web Assistant"
  },
  "content_scripts": [
    {
      "matches": [
        "https://scholarships.gov.in/*",
        "https://www.incometax.gov.in/*",
        "https://parivahan.gov.in/*",
        "https://uidai.gov.in/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": [
        "src/content/dom_inspector.js",
        "src/content/action_executor.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
